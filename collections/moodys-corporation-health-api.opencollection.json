{
  "opencollection": "1.0.0",
  "info": {
    "name": "Moody's Analytics Developer Platform Authentication Health API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.economy.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Moody's Get Platform Health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.economy.com/health"
          },
          "docs": "Returns the health status of the developer platform gateway."
        }
      ]
    }
  ],
  "bundled": true
}