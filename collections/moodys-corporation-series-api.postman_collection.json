        {
          "id": "4cba51e9-7d3a-45c8-9acb-0e90f05d6dc3",
          "name": "Moody's Retrieve Multiple Time Series",
          "request": {
            "name": "Moody's Retrieve Multiple Time Series",
            "description": {
              "content": "Returns data for up to 25 time series in a single request. Each series can have individual frequency, transformation, date range, and vintage parameters. Useful for efficiently fetching related economic indicators together.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "multi-series"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
